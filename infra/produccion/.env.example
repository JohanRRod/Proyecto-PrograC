# Copia este archivo como .env en la Raspberry Pi y llena los valores.
# El .env no se sube a GitHub (está en .gitignore).

# Base de datos (los mismos valores del .env de desarrollo)
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_USER=
DB_PASSWORD=

# RabbitMQ: corre en la misma Pi. Inventa un usuario y una clave.
RABBITMQ_USER=flexpass
RABBITMQ_PASSWORD=

# Supabase Auth
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ADMIN_KEY=
# A dónde llega el miembro desde el correo de invitación
SUPABASE_REDIRECT_URL=https://flexpass.TU_DOMINIO/auth/callback

JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Asistente de IA
GEMINI_API_KEY=

# Token del túnel (Cloudflare Zero Trust → Networks → Tunnels → tu túnel)
TUNNEL_TOKEN=
