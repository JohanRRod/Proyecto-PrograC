{
  "name": "FlexPass",
  "dataColors": ["#1D5FB8", "#23824F", "#D9A21B", "#C23A30", "#172026", "#5E6A71", "#7FA6DB", "#8CC4A5", "#E9C56A", "#E08B84"],
  "good": "#23824F",
  "neutral": "#D9A21B",
  "bad": "#C23A30",
  "maximum": "#1D5FB8",
  "center": "#E6EEF9",
  "minimum": "#FFFFFF",
  "background": "#FFFFFF",
  "foreground": "#172026",
  "tableAccent": "#1D5FB8",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#172026" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#2B363D" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5E6A71" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#172026" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F5F4" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DCE2E0" } }, "radius": 8 }]
      }
    }
  }
}
