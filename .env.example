
# ==================================
# POSTGRESQL - SUPABASE
# ==================================
DB_URL=jdbc:postgresql://TU_HOST:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_REAL

# ==================================
# RABBITMQ
# ==================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=gym_admin
RABBITMQ_PASSWORD=TU_PASSWORD_RABBITMQ

# ==================================
# SUPABASE AUTH
# ==================================
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY
SUPABASE_ADMIN_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_REDIRECT_URL=http://localhost:5173/auth/callback

# ==================================
# JWT
# ==================================
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# ==================================
# ASISTENTE DE IA (Google AI Studio)
# ==================================
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI
# Opcional: modelo de chat (por defecto gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
