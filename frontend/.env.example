# Copiar a .env.local y completar. No subir .env.local al repositorio.

# URL base de la API REST (sin barra final).
# En local se deja /api: Vite reenvía esas peticiones a http://localhost:8080 (ver vite.config.ts).
# En producción: la URL pública del backend, por ejemplo https://api.flexpass.com/api
VITE_API_URL=/api

# Proyecto de Supabase (Settings > API). Usar SOLO la publishable/anon key, nunca service_role.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY
